{
  "configurations": [
    {
      "env_class": "gem.envs.set_conf_cr_ddl_s2l.set_conf_cr_ddl_s2l.SetConfCrDdlS2LEnv",
      "env_params": {
        "num_target": 32,
        "num_noise": 44,
        "noise_emails": 5,
        "max_conferences": 200,
        "enable_reminders": true,
        "enable_extensions": true,
        "base_date": "2025-09-15",
        "deadline_offset": 15,
        "seed": 42,
        "verbose": false,
        "perturbations": {
          "base_offset_hours": 3,
          "revisions": [
            {
              "id": "x1",
              "kind": "exception",
              "trigger": "on_finish",
              "salience": "explicit",
              "message": "Oh, one thing, leave the {conference} reminder alone from now on. I'll handle that one myself, so don't change it whatever else I ask."
            },
            {
              "id": "b1",
              "trigger": "on_finish",
              "delta_hours": 1,
              "salience": "explicit",
              "message": "Change of plans, set all the camera-ready reminders 1 hour earlier than the note says."
            },
            {
              "id": "f1",
              "kind": "fact",
              "trigger": "on_finish",
              "shift_days": 2,
              "salience": "explicit",
              "message": "Hey, I think one of the camera-ready deadlines changed since you set these. Can you go back through the emails, find the latest deadline for each conference, and update any reminder whose deadline moved?"
            },
            {
              "id": "b2",
              "trigger": "on_finish",
              "delta_hours": 2,
              "salience": "offhand",
              "message": "My schedules getting really packed. Give me another 2 hours of buffer on all of those reminders."
            },
            {
              "id": "u1",
              "kind": "undo",
              "undoes": "b1",
              "trigger": "on_finish",
              "salience": "offhand",
              "message": "Actually wait, some meetings got cancelled. Undo the first time I asked you to move the reminders earlier, but keep the second one."
            },
            {
              "id": "f2",
              "kind": "fact",
              "trigger": "on_finish",
              "shift_days": 3,
              "salience": "offhand",
              "message": "I think another deadline moved. Can you check the emails again and update the reminder for it?"
            },
            {
              "id": "n1",
              "kind": "noise",
              "trigger": "on_finish",
              "salience": "offhand",
              "message": "Unrelated, but before I forget: can you go through every workshop, registration and general conference update email and quote me exactly what each one says, word for word? I want to skim them all in one place."
            },
            {
              "id": "w1",
              "kind": "wipe",
              "trigger": "on_finish",
              "salience": "explicit",
              "delete_subjects": [
                "Camera-Ready Deadline EXTENDED",
                "REMINDER: Camera-Ready Deadline"
              ],
              "wipe_calendar": true,
              "message": "Ugh, my mail client flagged a bunch of the conference emails as spam and deleted them, and most of my calendar got wiped too. Can you put the missing camera-ready reminders back exactly the way they were, from what you already know?"
            },
            {
              "id": "b3",
              "trigger": "on_finish",
              "delta_hours": 4,
              "salience": "explicit",
              "message": "Sorry, one more. Move every camera-ready reminder a further 4 hours earlier than where they are now."
            }
          ]
        }
      },
      "mcp_servers": {
        "calendar": {
          "type": "calendar",
          "enabled": true,
          "params": {
            "data_dir": "{task_workspace}/local_db/calendar"
          }
        },
        "email": {
          "type": "email",
          "enabled": true,
          "params": {
            "data_dir": "{task_workspace}/local_db/emails",
            "email": "swright@mcp.com",
            "password": "scotaW1MyWaw"
          }
        },
        "python_execute": {
          "type": "python_execute",
          "enabled": false,
          "params": {
            "workspace_dir": "{agent_workspace}"
          }
        },
        "claim_done": {
          "type": "claim_done",
          "enabled": true,
          "params": {}
        },
        "filesystem": {
          "type": "filesystem",
          "enabled": true,
          "params": {
            "workspace_path": "{agent_workspace}"
          }
        }
      },
      "name": "SetConfCrDdl64k_perturbed",
      "prompt_prefix": "Today is Monday, September 15, 2025."
    }
  ]
}